{
  "name": "@lntt/playbook",
  "version": "0.2.0",
  "description": "Checks and installs a company playbook: rules, processes, procedures, tools and skills as plain files.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunetteOrg/playbook-framework.git",
    "directory": "packages/playbook"
  },
  "homepage": "https://github.com/LunetteOrg/playbook-framework#readme",
  "bugs": "https://github.com/LunetteOrg/playbook-framework/issues",
  "engines": {
    "node": ">=24.12"
  },
  "bin": {
    "playbook": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/checker.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "playbook": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/checker.d.ts",
        "default": "./dist/checker.js"
      }
    }
  }
}
